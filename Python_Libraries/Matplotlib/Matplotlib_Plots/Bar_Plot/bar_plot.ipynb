    "import matplotlib.pyplot as plt\n",
    "\n",
    "products = [\"Laptop\", \"Phone\", \"Tablet\", \"Watch\"]\n",
    "sales = [45, 80, 35, 60]\n",
    "\n",
    "plt.bar(products, sales)\n",
    "\n",
    "plt.title(\"Product Sales\")\n",
    "plt.xlabel(\"Product\")\n",
    "plt.ylabel(\"Units Sold\")\n",
    "\n",
    "plt.show()"
   ]
  }
