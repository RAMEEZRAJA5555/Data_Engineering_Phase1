    "ages = [18, 19, 20, 21, 22, 20, 19, 23, 21, 22,\n",
    "        24, 20, 19, 21, 25, 22, 23, 20, 21, 19]\n",
    "\n",
    "plt.hist(ages)\n",
    "\n",
    "plt.title(\"Student Age Distribution\")\n",
    "plt.xlabel(\"Age\")\n",
    "plt.ylabel(\"Number of Students\")\n",
    "\n",
    "plt.show()"
   ]
  }
